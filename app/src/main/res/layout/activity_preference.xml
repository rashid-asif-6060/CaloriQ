<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caloriq_background"
    android:fillViewport="true"
    tools:context=".onboarding.PreferenceActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your routine"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A few details help us suggest practical meals and simple exercise routines."
            android:textColor="@color/caloriq_text_secondary"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Type of work"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgWorkType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_input"
            android:padding="14dp">

            <RadioButton
                android:id="@+id/rbDeskWork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mental / desk-based work"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

            <RadioButton
                android:id="@+id/rbPhysicalWork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Physical labor"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

            <RadioButton
                android:id="@+id/rbMixedWork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mixed work"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Workout status"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgWorkoutStatus"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <RadioButton
                android:id="@+id/rbWorkoutYes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Yes"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

            <RadioButton
                android:id="@+id/rbWorkoutNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Meals per day"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgMealsPerDay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <RadioButton
                android:id="@+id/rbMeals2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

            <RadioButton
                android:id="@+id/rbMeals3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

            <RadioButton
                android:id="@+id/rbMeals5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Food allergies"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAllergies"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Example: egg, nuts, milk"
            android:inputType="text"
            android:padding="14dp"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Disliked foods"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDislikedFoods"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Example: fish, lentils"
            android:inputType="text"
            android:padding="14dp"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Favorite food types"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFavoriteFoods"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Example: rice, chicken, vegetables"
            android:inputType="text"
            android:padding="14dp"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Budget preference"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgBudget"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <RadioButton
                android:id="@+id/rbBudgetLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Low"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

            <RadioButton
                android:id="@+id/rbBudgetMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Medium"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

            <RadioButton
                android:id="@+id/rbBudgetHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="High"
                android:textColor="@color/caloriq_text_primary"
                android:buttonTint="@color/caloriq_primary" />

        </RadioGroup>

        <Button
            android:id="@+id/btnFinishPreference"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/caloriq_primary"
            android:text="Generate my plan"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>