<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caloriq_background"
    android:fillViewport="true"
    tools:context=".commondashboard.ExportPlanActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvExportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export plan"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExportSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Review and share your generated diet plan."
            android:textColor="@color/caloriq_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvExportPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="6dp"
            android:padding="18dp"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="15sp"
            tools:text="Daily target: 2100 kcal\n\nBreakfast..." />

        <Button
            android:id="@+id/btnSharePlan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/caloriq_primary"
            android:text="Share plan"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>