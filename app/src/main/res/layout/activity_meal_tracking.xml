<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caloriq_background"
    android:fillViewport="true"
    tools:context=".commondashboard.MealTrackingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvMealTrackingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meal tracking"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMealTrackingSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mark meals as completed and watch your daily intake update."
            android:textColor="@color/caloriq_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvTrackedCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:text="Consumed today: 0 kcal"
            android:textColor="@color/caloriq_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbMeal1"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:buttonTint="@color/caloriq_primary"
            android:padding="18dp"
            android:text="Breakfast"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbMeal2"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:buttonTint="@color/caloriq_primary"
            android:padding="18dp"
            android:text="Lunch"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbMeal3"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:buttonTint="@color/caloriq_primary"
            android:padding="18dp"
            android:text="Dinner"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbMeal4"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:buttonTint="@color/caloriq_primary"
            android:padding="18dp"
            android:text="Snack 1"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbMeal5"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:buttonTint="@color/caloriq_primary"
            android:padding="18dp"
            android:text="Snack 2"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>