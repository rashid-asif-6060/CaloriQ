<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caloriq_background"
    android:fillViewport="true"
    tools:context=".auth.ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Recover password"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRecoveryEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your registered email"
            android:inputType="textEmailAddress"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnRecoverPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/caloriq_primary"
            android:text="Recover password"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

        <TextView
            android:id="@+id/tvRecoveredPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="5dp"
            android:padding="18dp"
            android:text="Your password will appear here after verification."
            android:textColor="@color/caloriq_text_secondary"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>