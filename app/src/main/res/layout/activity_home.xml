<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caloriq_background"
    android:fillViewport="true"
    tools:context=".commondashboard.HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your personalized CaloriQ summary"
            android:textColor="@color/caloriq_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daily calories"
                android:textColor="@color/caloriq_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDailyCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="2,100 kcal"
                android:textColor="@color/caloriq_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estimated target for your goal"
                android:textColor="@color/caloriq_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BMI"
                    android:textColor="@color/caloriq_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBmi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="22.4"
                    android:textColor="@color/caloriq_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBmiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Normal"
                    android:textColor="@color/caloriq_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <Space
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Goal"
                    android:textColor="@color/caloriq_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Weight Loss"
                    android:textColor="@color/caloriq_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Active plan"
                    android:textColor="@color/caloriq_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Quick actions"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnViewDietPlan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/caloriq_primary"
            android:text="View diet plan"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnTrackMeal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/caloriq_accent"
            android:text="Track meals"
            android:textAllCaps="false"
            android:textColor="@color/caloriq_primary"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnViewProgress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/caloriq_accent"
            android:text="View progress"
            android:textAllCaps="false"
            android:textColor="@color/caloriq_primary"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnViewProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/caloriq_accent"
            android:text="View profile"
            android:textAllCaps="false"
            android:textColor="@color/caloriq_primary"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnViewReminders"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/caloriq_accent"
            android:text="Reminders"
            android:textAllCaps="false"
            android:textColor="@color/caloriq_primary"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnExportPlan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/caloriq_accent"
            android:text="Export plan"
            android:textAllCaps="false"
            android:textColor="@color/caloriq_primary"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>