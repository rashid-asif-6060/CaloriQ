<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caloriq_background"
    android:fillViewport="true"
    tools:context=".commondashboard.ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvProfileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProfileSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your saved CaloriQ information"
            android:textColor="@color/caloriq_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvProfileBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="6dp"
            android:padding="18dp"
            android:textColor="@color/caloriq_text_primary"
            android:textSize="16sp"
            tools:text="Age: 22\nGender: Male" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/caloriq_accent"
            android:text="Log out"
            android:textAllCaps="false"
            android:textColor="@color/caloriq_primary"
            android:textSize="16sp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>